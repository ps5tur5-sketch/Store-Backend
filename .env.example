DATABASE_URL=postgresql://hr:hr@127.0.0.1:5432/hr
# Docker bind-address и внешний порт бэкенда меняются только здесь.
BACKEND_BIND_IP=0.0.0.0
BACKEND_PORT=3000
POSTGRES_DB=hr
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
WORKER_ENABLED=true
WORKER_POLL_MS=200
RECOVERY_POLL_MS=5000
SUPPLIER_BASE_URL=http://127.0.0.1:3000
SUPPLIER_TIMEOUT_MS=300
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_MS=50
ENABLE_TEST_CONTROLS=true

# Demo role accounts are created only on first startup.
ADMIN_USERNAME=admin_demo
ADMIN_PASSWORD=AdminDemo2026!
SELLER_PASSWORD=SellerDemo2026!

# Internal supplier stub authentication
SUPPLIER_SHARED_SECRET=LocalSupplierDemo2026!

# Add 7200 stable test keys and four additional sellers on startup.
DEMO_MARKETPLACE=true
